# ==========================================================
# AnnotaLab — LOCAL DEVELOPMENT Environment Variables
# ==========================================================
# Questo file è SOLO per lo sviluppo locale (manage.py runserver).
# Per la produzione Docker, usa .env.prod (vedi .env.prod.example).
# ==========================================================

# Backend - General settings
DEBUG=1
SECRET_KEY=django-insecure-change-me-in-production

# Put your domain and VPS IP here (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS & CSRF Settings (comma-separated, required for Docker)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:80,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:80,http://localhost

# Database Settings
# NOTE: For local dev (manage.py runserver), use 127.0.0.1
# The docker-compose-fullstack.yml overrides this to "db" automatically.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# Frontend URL (used for CORS/redirects)
FRONTEND_URL=http://localhost:5173