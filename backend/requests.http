@host = http://localhost:8000
@pid = test_user_123
@project_id = 1

### 0. Healthcheck
GET {{host}}/api/v1/healthcheck


### 1. SESSION MANAGEMENT

### Initialize Session
POST {{host}}/api/v1/session/
Content-Type: application/json

{
    "prolific_pid": "{{pid}}",
    "project_id": {{project_id}},
    "is_test": true,
    "metadata": {
        "browser": "Chrome",
        "os": "Windows"
    }
}


### 2. ONBOARDING

### Get Consent
GET {{host}}/api/v1/get-consent/?prolific_pid={{pid}}&project_id={{project_id}}


### Accept Consent
POST {{host}}/api/v1/consent/
Content-Type: application/json

{
    "prolific_pid": "{{pid}}",
    "project_id": {{project_id}}
}


### Get Screening
GET {{host}}/api/v1/get-screening/?prolific_pid={{pid}}&project_id={{project_id}}


### Submit Screening
POST {{host}}/api/v1/screening/
Content-Type: application/json

{
    "prolific_pid": "{{pid}}",
    "project_id": {{project_id}},
    "responses": {
        "age": 25,
        "gender": "Male",
        "native_language": "English"
    }
}


### Get Codebook
GET {{host}}/api/v1/get-codebook/?prolific_pid={{pid}}&project_id={{project_id}}


### Complete Codebook
POST {{host}}/api/v1/codebook/
Content-Type: application/json

{
    "prolific_pid": "{{pid}}",
    "project_id": {{project_id}}
}


### Get Instructions
GET {{host}}/api/v1/get-instructions/?prolific_pid={{pid}}&project_id={{project_id}}


### Complete Onboarding
POST {{host}}/api/v1/onboarding/
Content-Type: application/json

{
    "prolific_pid": "{{pid}}",
    "project_id": {{project_id}}
}



### 3. ANNOTATION PHASE

### Get Next Task
# The user might receive a normal document or a gold unit.
GET {{host}}/api/v1/next-task/?prolific_pid={{pid}}&project_id={{project_id}}


### Submit Annotation
POST {{host}}/api/v1/submit/
Content-Type: application/json

{
    "prolific_pid": "{{pid}}",
    "project_id": {{project_id}},
    "document": "UUID-OF-THE-DOCUMENT-HERE",
    "milliseconds_to_complete": 15000,
    "result": {
        "classification": "Yes",
        "spans": [
            {
                "start": 10,
                "end": 25,
                "label": "Actor",
                "text": "The government"
            }
        ]
    }
}