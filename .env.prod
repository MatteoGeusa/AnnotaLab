# ==========================================================
# AnnotaLab — PRODUCTION Environment Variables (Docker)
# ==========================================================

# Backend - General settings
DEBUG=0
SECRET_KEY=django-insecure-change-me-in-production-PLEASE-CHANGE-THIS

# Put your domain and VPS IP here (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS & CSRF Settings
# Leaving these empty activates the auto-detection from ALLOWED_HOSTS
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Database Settings
# In Docker, we use the service name "db"
POSTGRES_HOST=db
POSTGRES_DB=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# Frontend URL
# Leaving this empty activates dynamic detection based on the current request
FRONTEND_URL=
