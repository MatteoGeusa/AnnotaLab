# ==========================================================
# AnnotaLab — PRODUCTION Environment Variables (TEMPLATE)
# ==========================================================
# Rinomina questo file in .env.prod sul server di produzione.
# I valori qui sotto sono pensati per Docker Fullstack.

# Backend - General settings
DEBUG=0
SECRET_KEY=cambiami-con-una-stringa-lunga-e-casuale

# Inserisci qui il dominio o l'IP del server (es. 1.2.3.4,backend)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Lascia vuoti questi tre per attivare l'auto-configurazione intelligente
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=annotalab_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password_sicura
POSTGRES_PORT=5432
